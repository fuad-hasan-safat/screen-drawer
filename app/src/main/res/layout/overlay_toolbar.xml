<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_toolbar_pill"
    android:paddingHorizontal="6dp"
    android:paddingVertical="6dp"
    android:elevation="8dp">

    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="24dp"
        android:layout_height="40dp"
        android:padding="6dp"
        android:src="@drawable/ic_drag_handle"
        android:tint="@color/color_muted" />

    <View
        android:layout_width="1dp"
        android:layout_height="28dp"
        android:layout_marginHorizontal="4dp"
        android:background="#33FFFFFF" />

    <ImageButton
        android:id="@+id/btnToggleMode"
        style="@style/ToolbarIconButton"
        android:contentDescription="Toggle draw mode"
        android:src="@drawable/ic_pen" />

    <ImageButton
        android:id="@+id/btnTool"
        style="@style/ToolbarIconButton"
        android:contentDescription="Change tool"
        android:src="@drawable/ic_eraser" />

    <com.fuad.screendrawer.ColorSwatchView
        android:id="@+id/colorSwatch"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="4dp"
        android:contentDescription="Choose color" />

    <ImageButton
        android:id="@+id/btnUndo"
        style="@style/ToolbarIconButton"
        android:contentDescription="Undo"
        android:src="@drawable/ic_undo" />

    <ImageButton
        android:id="@+id/btnRedo"
        style="@style/ToolbarIconButton"
        android:contentDescription="Redo"
        android:src="@drawable/ic_redo" />

    <ImageButton
        android:id="@+id/btnClear"
        style="@style/ToolbarIconButton"
        android:contentDescription="Clear"
        android:src="@drawable/ic_clear" />

    <View
        android:layout_width="1dp"
        android:layout_height="28dp"
        android:layout_marginHorizontal="4dp"
        android:background="#33FFFFFF" />

    <ImageButton
        android:id="@+id/btnExit"
        style="@style/ToolbarIconButton"
        android:contentDescription="Exit"
        android:src="@drawable/ic_close"
        android:tint="@color/color_danger" />

</LinearLayout>
