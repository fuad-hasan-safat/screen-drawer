<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="288dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel_card"
    android:padding="18dp"
    android:elevation="16dp">

    <View
        android:layout_width="56dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_accent_stripe" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/panelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pen settings"
            android:textColor="@color/color_on_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnPanelClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="Close"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:tint="@color/color_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/colorGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.fuad.screendrawer.ColorWheelView
            android:id="@+id/colorWheel"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.08"
            android:text="Brightness"
            android:textAllCaps="true"
            android:textColor="@color/color_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/brightnessSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/color_accent"
            android:thumbTint="@color/color_accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.08"
            android:text="Quick colors"
            android:textAllCaps="true"
            android:textColor="@color/color_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/presetRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="6dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:letterSpacing="0.08"
        android:text="Brush size"
        android:textAllCaps="true"
        android:textColor="@color/color_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <SeekBar
        android:id="@+id/strokeSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="40"
        android:min="4"
        android:progress="12"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="@color/color_accent"
        android:thumbTint="@color/color_accent" />

    <LinearLayout
        android:id="@+id/opacityGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.08"
            android:text="Opacity"
            android:textAllCaps="true"
            android:textColor="@color/color_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/opacitySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:min="10"
            android:progress="40"
            android:progressBackgroundTint="#33FFFFFF"
            android:progressTint="@color/color_accent"
            android:thumbTint="@color/color_accent" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#26FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnStylusOnly"
            style="@style/ToolbarIconButton"
            android:contentDescription="Stylus only"
            android:src="@drawable/ic_stylus" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Stylus only\nIgnores finger touch on the canvas"
            android:textColor="@color/color_muted"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
